# Application
APP_NAME=ResearchMate AI
APP_ENV=development

# Database (SQLite for local; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./researchmate.db

# Academic API
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# LLM (Google Gemini)
LLM_API_KEY=your_google_gemini_api_key_here

# File Upload
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=20

# Mock mode — set to true to skip real API calls during development/testing
MOCK_SEMANTIC_SCHOLAR=false